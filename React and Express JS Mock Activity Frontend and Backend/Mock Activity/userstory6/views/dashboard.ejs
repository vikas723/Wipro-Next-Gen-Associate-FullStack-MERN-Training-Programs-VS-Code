<h2>Admin Dashboard</h2>
<table border="1">
<tr><th>Name</th><th>Price</th><th>Category</th></tr>
<% products.forEach(p => { %>
<tr>
<td><%= p.name %></td>
<td><%= p.price %></td>
<td><%= p.category %></td>
</tr>
<% }) %>
</table>
