<form method="post" action="/students/enroll">
  <select name="StudentId">
    <% students.forEach(s => { %>
      <option value="<%= s.id %>"><%= s.name %></option>
    <% }) %>
  </select>

  <select name="CourseId">
    <% courses.forEach(c => { %>
      <option value="<%= c.id %>"><%= c.title %></option>
    <% }) %>
  </select>

  <input name="paymentAmount" placeholder="Payment" />
  <button>Enroll</button>
</form>